[Unit]
# Local model arbitration: one endpoint offering every model this host can serve,
# swapping them only while idle. Sits *behind* mind-router -- point that host's
# MIND_AMD (or MIND_STUDIO) at this port instead of at a single model's server, and
# the router keeps doing prefix-aware host routing with no change.
Description=Local Mind model arbiter
Documentation=https://github.com/yijunyu/mind-radix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=MIND_ARBITER_HOST=127.0.0.1
Environment=MIND_ARBITER_PORT=8010
Environment=MIND_ARBITER_MODELS=%h/.config/mind/models.json
# Leave this much of the pool unused when deciding whether a model fits. A sweep on
# the gfx1151 box was killed at MemAvailable < 3 GiB while its own plan said it fit,
# so the guard is deliberately loose.
Environment=MIND_ARBITER_RESERVE_GIB=8
EnvironmentFile=-%h/.local/state/ds4-local/mind-arbiter.env
ExecStart=/usr/bin/python3 %h/mind-arbiter.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
